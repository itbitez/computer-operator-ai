# ─────────────────────────────────────────────────────────────────────────────
# Computer Operator AI — environment template. Copy to .env and fill in.
# .env and .env.* are gitignored; this example is the only tracked env file.
# ─────────────────────────────────────────────────────────────────────────────

# Next.js supplies NODE_ENV itself (development in dev, production in start,
# test in CI). Only set it here if you need to override that.
NODE_ENV=development

# PostgreSQL connection string (used from Unit 05 onwards)
DATABASE_URL=postgresql://postgres:dev-password@localhost:5432/computer-operator-ai

# Redis connection string (queue and rate-limit counters, Unit 06 onwards)
REDIS_URL=redis://localhost:6379
